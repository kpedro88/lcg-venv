#!/bin/bash -e
#
# lcg-venv: create a Python virtual environment on top of an LCG view that
# behaves like a "real" venv -- packages you install locally take precedence
# over the ones shipped in the LCG view, while LCG-only packages (ROOT,
# Geant4, ...) stay importable.
#
# This is the LCG analogue of CMSSW's scram-venv. The difference from
# matthewfeickert/cvmfs-venv is *where* the PYTHONPATH problem is fixed:
# instead of rewriting bin/activate to reshuffle $PYTHONPATH in the shell,
# we fix sys.path *inside the interpreter* with a .pth import hook (the same
# idea CMSSW uses with sitecustomize.py). Consequences:
#
#   * Works no matter how python is launched -- `activate`, direct call to
#     <venv>/bin/python, a shebang script, a subprocess, Jupyter, etc.
#   * The .pth hook is the whole sys.path story; nothing line-numbered is
#     injected into the activate template.
#   * The script is only needed once, at creation time.
#
# There is ONE thing that must be fixed at the shell level: PYTHONHOME.
# LCG's setup.sh sets PYTHONHOME so that programs embedding their own
# libpython (notably the LCG `gdb`, whose build-time stdlib path no longer
# exists) can locate the stdlib. Stock venv `activate` *unsets* PYTHONHOME,
# which makes those embedded interpreters fail with
# "ModuleNotFoundError: No module named 'encodings'". A .pth/sitecustomize
# hook cannot help here -- the embedded interpreter crashes before it can
# read any .pth file -- so PYTHONHOME must be present in the environment.
# We therefore re-set PYTHONHOME at the end of activation. It points at this
# venv's own base interpreter, so keeping it set is safe for the venv python.
#
# Usage:
#   source /cvmfs/sft.cern.ch/lcg/views/LCG_109a/x86_64-el9-gcc13-opt/setup.sh
#   lcg-venv [venv-name]          # default name: venv
#   . venv/bin/activate
#
# Requires: an LCG view (or any environment that puts CVMFS packages on
# PYTHONPATH) already set up, with python3 >= 3.3 on PATH.

VENV_NAME="${1:-venv}"

# --- sanity checks ----------------------------------------------------------
if ! command -v python3 >/dev/null 2>&1; then
  echo "lcg-venv: no python3 on PATH; set up an LCG view first" >&2
  exit 1
fi

PYTHON="$(command -v python3)"
case "$PYTHON" in
  /cvmfs/*) : ;;  # good, this is the LCG/CVMFS python
  *) echo "lcg-venv: warning: python3 ($PYTHON) is not under /cvmfs;" \
          "is an LCG view set up?" >&2 ;;
esac

if [ -e "$VENV_NAME" ]; then
  echo "lcg-venv: '$VENV_NAME' already exists; remove it or pick another name" >&2
  exit 1
fi

# --- create the venv --------------------------------------------------------
# --system-site-packages is required so the LCG view's packages remain
# visible; the .pth hook below is what makes local installs win regardless.
echo "lcg-venv: creating virtual environment '$VENV_NAME'"
"$PYTHON" -m venv --system-site-packages "$VENV_NAME"

# Resolve the venv's site-packages directory (purelib) from the venv python
# itself, so we don't have to guess the python X.Y directory name.
SITE_DIR="$("$VENV_NAME/bin/python" - <<'PY'
import sysconfig
print(sysconfig.get_path("purelib"))
PY
)"

if [ -z "$SITE_DIR" ] || [ ! -d "$SITE_DIR" ]; then
  echo "lcg-venv: could not locate venv site-packages" >&2
  exit 1
fi

# --- install the sys.path fix ----------------------------------------------
# The fix has two cooperating pieces, needed because of *when* Python's `site`
# module runs each kind of hook at startup:
#
#   1. _lcgvenv_pathfix.pth  -> imports _lcgvenv_pathfix, which PROMOTES this
#      venv's site-packages to the front of sys.path. .pth files are processed
#      early, so this ensures our own sitecustomize.py (below) is the one that
#      gets imported, instead of the LCG view's shadowing it.
#
#   2. sitecustomize.py      -> DEMOTES every directory the LCG view injected
#      via PYTHONPATH to the tail of sys.path. site.main() runs sitecustomize
#      *after all* .pth files, so this reliably wins even against paths that
#      .pth files append later -- most importantly `pip install -e` (editable
#      installs), which drop a .pth that appends the project source dir. A
#      .pth-only fix cannot catch those, because .pth files run in sorted order
#      and an editable .pth may sort after ours. sitecustomize always runs last.
#
# Because `site` imports only the first sitecustomize.py found on sys.path,
# ours also chains to the next one (e.g. the LCG view's) so its behaviour is
# preserved.

# Piece 1: the .pth promoter.
cat > "$SITE_DIR/_lcgvenv_pathfix.py" <<'PY'
"""Promote this venv's site-packages to the front of sys.path.

Runs early (imported from a .pth file) so that the venv's own sitecustomize.py
is discovered by `site` ahead of the LCG view's. The authoritative reordering
happens later in sitecustomize.py.
"""
import sys
import sysconfig


def _venv_site_dirs():
    dirs = []
    for key in ("purelib", "platlib"):
        try:
            p = sysconfig.get_path(key)
        except Exception:
            continue
        if p and p not in dirs:
            dirs.append(p)
    return dirs


def _promote():
    # Only act inside a venv (sys.prefix != sys.base_prefix).
    if getattr(sys, "prefix", None) == getattr(sys, "base_prefix", None):
        return
    venv_dirs = [d for d in _venv_site_dirs() if d in sys.path]
    if not venv_dirs:
        return
    remaining = [p for p in sys.path if p not in venv_dirs]
    sys.path[:] = venv_dirs + remaining


_promote()
PY

# The .pth import line is executed by the site module during startup.
echo "import _lcgvenv_pathfix" > "$SITE_DIR/_lcgvenv_pathfix.pth"

# Piece 2: the sitecustomize demoter (+ chain to any next sitecustomize).
cat > "$SITE_DIR/sitecustomize.py" <<'PY'
"""lcg-venv: make this venv's packages win over the LCG view's.

Runs from the `site` module at interpreter startup, *after* every .pth file
has been processed (site.main() calls execsitecustomize() last). That timing
is essential: editable installs (`pip install -e`) drop a .pth that appends
their source dir to sys.path, and .pth files run in sorted order, so a .pth
hook cannot reliably reorder around them. A sitecustomize always runs last.

Strategy: move every directory that the LCG view injected via PYTHONPATH to
the *tail* of sys.path. Whatever remains ahead -- the venv site-packages and
any editable/source dirs added by .pth files -- keeps priority, while all LCG
packages stay importable from the tail.
"""
import os
import os.path as _osp
import sys


def _demote_lcg_paths():
    # Only act inside a venv.
    if getattr(sys, "prefix", None) == getattr(sys, "base_prefix", None):
        return
    pythonpath = os.environ.get("PYTHONPATH", "")
    if not pythonpath:
        return
    lcg = set()
    for d in pythonpath.split(os.pathsep):
        if not d:
            continue
        try:
            lcg.add(_osp.realpath(d))
        except Exception:
            pass
    if not lcg:
        return
    keep, tail = [], []
    for p in sys.path:
        try:
            rp = _osp.realpath(p)
        except Exception:
            rp = p
        (tail if rp in lcg else keep).append(p)
    if tail:  # preserve relative order within each group
        sys.path[:] = keep + tail


def _chain_next_sitecustomize():
    # `site` imports only the first sitecustomize on sys.path (this one). Run
    # the next one down the path (e.g. the LCG view's) so its behaviour is
    # preserved. Exec in a throwaway namespace to avoid import recursion.
    try:
        myself = _osp.realpath(__file__)
    except Exception:
        return
    for d in sys.path:
        try:
            cand = _osp.realpath(_osp.join(d, "sitecustomize.py"))
        except Exception:
            continue
        if cand == myself or not _osp.isfile(cand):
            continue
        try:
            with open(cand) as fh:
                code = compile(fh.read(), cand, "exec")
            exec(code, {"__file__": cand, "__name__": "sitecustomize"})
        except Exception:
            pass
        break


_demote_lcg_paths()
_chain_next_sitecustomize()
PY

# --- keep PYTHONHOME set for embedded interpreters (e.g. gdb) ---------------
# Append a restore step to the end of the activation scripts that unset
# PYTHONHOME. Stock venv stashes the old value in _OLD_VIRTUAL_PYTHONHOME
# before unsetting it, so we just put it back. deactivate() still restores and
# unsets _OLD_VIRTUAL_PYTHONHOME as usual, so the round-trip stays clean.
# csh's activate.csh does not touch PYTHONHOME, so it needs no change.
BIN_DIR="$VENV_NAME/bin"

if [ -f "$BIN_DIR/activate" ]; then
  cat >> "$BIN_DIR/activate" <<'EOF'

# Added by lcg-venv: keep PYTHONHOME set so programs that embed their own
# libpython (e.g. the LCG gdb) can still find the stdlib. It points at this
# venv's base interpreter, so it is safe for the venv python too.
if [ -n "${_OLD_VIRTUAL_PYTHONHOME:-}" ] ; then
    PYTHONHOME="${_OLD_VIRTUAL_PYTHONHOME}"
    export PYTHONHOME
fi
EOF
fi

if [ -f "$BIN_DIR/activate.fish" ]; then
  cat >> "$BIN_DIR/activate.fish" <<'EOF'

# Added by lcg-venv: keep PYTHONHOME set so programs that embed their own
# libpython (e.g. the LCG gdb) can still find the stdlib.
if set -q _OLD_VIRTUAL_PYTHONHOME
    set -gx PYTHONHOME $_OLD_VIRTUAL_PYTHONHOME
end
EOF
fi

echo "lcg-venv: done. Activate with:  . $VENV_NAME/bin/activate"
